# srvhome - per-server "running apps" home page.
# Optional: the crontab keepalive from install.sh already keeps this
# alive without sudo. Install this unit if you'd rather run it under
# systemd (then remove the two `srvhome/run.sh` lines from `crontab -e`).
#
#   sudo cp /home/bdr/projects/BdRPiAMI/srvhome/srvhome.service \
#           /etc/systemd/system/srvhome.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now srvhome
#
[Unit]
Description=srvhome - per-server running-apps home page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bdr
WorkingDirectory=/home/bdr/projects/BdRPiAMI/srvhome
ExecStart=/usr/bin/python3 /home/bdr/projects/BdRPiAMI/srvhome/srvhome.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
