[Unit]
Description=BdRGUI round-robin scheduler
After=network.target

[Service]
Type=simple
User=bdr
WorkingDirectory=/home/bdr/projects/_BdRGUI/app
Environment=PROJECTS_DIR=/home/bdr/projects
Environment=STATE_DIR=/home/bdr/projects/_BdRGUI/state
Environment=CLAUDE_LAUNCH_CMD=/home/bdr/.local/bin/claude
ExecStart=/home/bdr/projects/_BdRGUI/venv/bin/python3 /home/bdr/projects/_BdRGUI/app/scheduler.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
