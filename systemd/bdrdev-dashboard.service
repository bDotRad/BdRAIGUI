[Unit]
Description=BdRDev dashboard (web UI)
After=network.target

[Service]
Type=simple
User=bdr
WorkingDirectory=/home/bdr/projects/BdRDev/app
Environment=PROJECTS_DIR=/home/bdr/projects
Environment=STATE_DIR=/home/bdr/projects/BdRDev/state
# Fleet/ecosystem data source: self-hosted Supabase on BdRPiSrvAMI (the Pi).
# Reached by LAN IP -- the pi's mDNS name changed to bdrpisrvami.local in the
# 2026-08-29 rename and doesn't resolve from this box; 10.10.10.20 is in the
# cert SAN. /home/bdr/fleetCA.crt is the "BdR Fleet Local CA" that signed it.
# Unset SUPABASE_URL / SERVICE_KEY = the dashboard just uses
# state/ecosystem.json. See app/fleet_db.py.
Environment=SUPABASE_URL=https://10.10.10.20
Environment=SUPABASE_CA_BUNDLE=/home/bdr/fleetCA.crt
# The service-role JWT is the one secret here -- kept out of git in this
# (gitignored) file rather than inline. `-` = start anyway if it's absent.
EnvironmentFile=-/home/bdr/projects/BdRDev/state/fleet_db.env
ExecStart=/home/bdr/projects/BdRDev/venv/bin/python3 /home/bdr/projects/BdRDev/app/dashboard.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
