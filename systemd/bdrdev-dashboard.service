[Unit]
Description=BdRDev dashboard (web UI)
After=network.target

[Service]
Type=simple
User=bdr
WorkingDirectory=/home/bdr/projects/BdRDev/app
Environment=PROJECTS_DIR=/home/bdr/projects
Environment=STATE_DIR=/home/bdr/projects/BdRDev/state
# Fleet/ecosystem data source (self-hosted Supabase on BdRPiAMI). Unset =
# the dashboard just uses state/ecosystem.json. See app/fleet_db.py.
# Environment=SUPABASE_URL=https://bdrpiami.local
# Environment=SUPABASE_SERVICE_KEY=<service-role JWT>
# The Pi serves bdrpiami.local with a self-signed cert -- either skip
# verification or point at a CA bundle:
# Environment=SUPABASE_VERIFY_SSL=0
# Environment=SUPABASE_CA_BUNDLE=/home/bdr/projects/BdRDev/tls/bdrpiami-ca.pem
ExecStart=/home/bdr/projects/BdRDev/venv/bin/python3 /home/bdr/projects/BdRDev/app/dashboard.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
