[Unit]
Description=BdRGUI dashboard (web UI)
After=network.target

[Service]
Type=simple
User=bdr
WorkingDirectory=/home/bdr/projects/_BdRGUI/app
Environment=PROJECTS_DIR=/home/bdr/projects
Environment=STATE_DIR=/home/bdr/projects/_BdRGUI/state
ExecStart=/home/bdr/projects/_BdRGUI/venv/bin/python3 /home/bdr/projects/_BdRGUI/app/dashboard.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
